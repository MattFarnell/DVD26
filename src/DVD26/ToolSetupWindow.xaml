<Window x:Class="DVD26.ToolSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up FFmpeg — DVD26" Width="650" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#14161B" Foreground="#F4F4F6">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="27" FontWeight="SemiBold" Text="Connect FFmpeg" />
        <TextBlock Grid.Row="1" Margin="0,8,0,22" Foreground="#A7ABB7" TextWrapping="Wrap"
                   Text="On first run, select the two executables from the bin folder of your extracted Windows FFmpeg download. DVD26 stores their locations; it does not upload or copy the files." />

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Margin="4,0" FontWeight="SemiBold" Text="FFmpeg executable" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FfmpegPathBox" IsReadOnly="True" ToolTip="Path to ffmpeg.exe" />
                <Button Grid.Column="1" Content="Select ffmpeg.exe…" Click="SelectFfmpeg_Click" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Margin="4,0" FontWeight="SemiBold" Text="FFprobe executable" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FfprobePathBox" IsReadOnly="True" ToolTip="Path to ffprobe.exe" />
                <Button Grid.Column="1" Content="Select ffprobe.exe…" Click="SelectFfprobe_Click" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="4,14" Foreground="#FF9A9A" TextWrapping="Wrap" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#A7ABB7" Text="No files are added to the repository." />
            <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" />
            <Button Grid.Column="2" Content="Save and continue" Background="{StaticResource AccentBrush}" Foreground="White" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
